[Unit]
Description=Google Drive video sync server
After=network-online.target
Wants=network-online.target

[Service]
User=drive-server
WorkingDirectory=/opt/google-drive-server
EnvironmentFile=/opt/google-drive-server/.env
ExecStart=/usr/bin/java -Xmx512m -jar /opt/google-drive-server/app.jar
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/google-drive-server/data

[Install]
WantedBy=multi-user.target
